{
  "id": "fbneo-unified",
  "version": "1.0.0.3",
  "runtime_api": 1,
  "supported_platforms": ["arcade", "neogeo", "cps1", "cps2", "cps3", "fbneo"],
  "supported_abis": ["arm64-v8a", "x86_64"],
  "min_sdk": 26,
  "target_sdk": 35,
  "rom_extensions": [".zip", ".7z"],
  "rom_asset_path": "assets/game.rom",
