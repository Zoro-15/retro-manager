{
  "id": "pce-unified",
  "version": "1.31.0",
  "runtime_api": 1,
  "supported_platforms": ["pce", "tg16", "sgx"],
  "supported_abis": ["arm64-v8a", "x86_64"],
  "min_sdk": 26,
  "target_sdk": 35,
  "rom_extensions": [".pce", ".sgx", ".cue", ".iso"],
  "rom_asset_path": "assets/game.rom",
  "config_asset_path": "assets/retropack.json",
  "config_schema_version": 1,
  "capabilities": {
    "save_states": 4,
    "rewind": true,
    "fast_forward": true,
    "touch_controls": true,
    "physical_gamepad": true,
    "bios_optional": true
  },
  "protected_entries": {}
}
