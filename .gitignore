# Gradle & Build Artifacts
.gradle/
.kotlin/
build/
*/build/
bin/

# IDE & Editor Configuration
.idea/
*.iml
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Android Build Outputs
*.apk
*.aab
*.ap_
*.dex

# Pinned runtime template bundles are intentionally COMMITTED (trust anchors in
# RuntimeRegistry.kt / RuntimeDescriptor.kt / runtime.json rotate in lockstep
# with this file). Re-include them despite the blanket *.apk exclusion above.
# NOTE: keep this block BELOW the blanket *.apk rule.
!runtimes/**/*.apk

# Secrets, Private Keys & Local Properties (Never commit private release keys)
local.properties
key.properties
*.keystore
*.jks
*.p12
*.pfx
managed_key.bin
keystore/

# Temporary Files
*.tmp
*.log

# Game ROMs & Archives (Never commit copyrighted game binaries)
*.zip
*.gba
*.gbc
*.gb
*.nds

# Upstream reference staging area (quarantined / untracked)
staging/
dist/
